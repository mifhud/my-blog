---
layout: base.njk
---

<article class="article-page">
  <header class="article-header">
    <h1 class="article-title">{{ title }}</h1>
    
    <div class="article-meta">
      <time datetime="{{ page.date | dateISO }}">
        {{ page.date | dateReadable }}
      </time>
    </div>
  </header>

  <div class="article-content">
    {{ content | removeFirstH1 | safe }}
  </div>

  <footer class="article-footer">
    <div class="article-navigation">
      {% set previousPost = collections.blog | getPreviousCollectionItem(page) %}
      {% set nextPost = collections.blog | getNextCollectionItem(page) %}
      
      {% if previousPost %}
      <div class="prev-article">
        <span class="label">← Previous Article</span>
        <a href="{{ previousPost.url | url }}">{{ previousPost.data.title }}</a>
      </div>
      {% endif %}
      
      {% if nextPost %}
      <div class="next-article">
        <span class="label">Next Article →</span>
        <a href="{{ nextPost.url | url }}">{{ nextPost.data.title }}</a>
      </div>
      {% endif %}
    </div>
    
    <div class="back-to-articles">
      <a href="{{ '/blog/' | url }}">← Back to All Articles</a>
    </div>
  </footer>
</article>
