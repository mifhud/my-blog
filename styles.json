{
  "project_name": "Portfolio",
  "typography": {
    "font_family": "Inter, Montserrat, or Poppins, sans-serif",
    "headings": {
      "h1": {
        "size": "48px",
        "weight": "700 (Bold)",
        "letter_spacing": "-0.02em"
      },
      "h2": {
        "size": "32px",
        "weight": "600 (Semi-bold)",
        "style": "Typewriter/Cursor effect"
      }
    },
    "body": {
      "size": "16px",
      "line_height": "1.6",
      "weight": "400 (Regular)"
    },
    "nav_links": {
      "size": "14px",
      "weight": "500",
      "text_transform": "capitalize"
    }
  },
  "color_palette": {
    "primary_accent": "#2DD4BF",
    "dark_mode": {
      "background": "#18181B",
      "text_primary": "#FFFFFF",
      "text_secondary": "#A1A1AA",
      "surface": "#27272A",
      "nav_inactive": "#A1A1AA"
    },
    "light_mode": {
      "background": "#FFFFFF",
      "text_primary": "#18181B",
      "text_secondary": "#52525B",
      "surface": "#FFFFFF",
      "nav_inactive": "#52525B"
    }
  },
  "ui_components": {
    "avatar": {
      "shape": "circle",
      "border_radius": "50%",
      "size": "400px"
    },
    "buttons": {
      "primary": {
        "border_color": "#2DD4BF",
        "border_width": "1px",
        "border_radius": "25px",
        "padding": "12px 30px",
        "text_color": "#2DD4BF"
      }
    },
    "icons": {
      "style": "Circular fill",
      "background": "#2DD4BF",
      "icon_color": "Inherit from mode background"
    }
  },
  "layout": {
    "container_width": "1200px",
    "header_height": "80px",
    "spacing_unit": "8px"
  }
}